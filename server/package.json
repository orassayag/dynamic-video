{
  "name": "dynamic-video-server",
  "version": "0.1.0",
  "private": false,
  "description": "Dynamic Video is a full-stack web application built with Node.js/Express and Next.js and React. It allows users to generate personalized, professional videos using the Idomoo API. Features include an interactive form interface for real-time customization of text, colors, images, and formats",
  "keywords": [
    "dynamic-video-generation",
    "idomoo-api",
    "full-stack-application",
    "node-js",
    "express-backend",
    "next-js",
    "react-frontend",
    "material-ui",
    "rest-api",
    "swagger-documentation",
    "video-personalization",
    "storyboard-templates",
    "real-time-progress-tracking",
    "video-rendering",
    "multimedia-api",
    "user-customization",
    "cloud-video-generation",
    "form-based-interface",
    "api-integration",
    "responsive-web-app"
  ],
  "homepage": "https://github.com/orassayag/dynamic-video#readme",
  "bugs": {
    "url": "https://github.com/orassayag/dynamic-video/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/orassayag/dynamic-video.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/orassayag"
  },
  "license": "MIT",
